# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# --- Local API ---
# Port the FastAPI app is exposed on (see Quick Start).
API_PORT=5001

# --- Embeddings (semantic guideline search) ---
# Required to (re)generate embedding fixtures and run the AI enrichment flow.
OPENAI_API_KEY=
# Optional: override the OpenAI-compatible endpoint (defaults to OpenAI).
# OPENAI_BASE_URL=

# --- LLM provider (AWS Bedrock) ---
# Bedrock model id used for AI enrichment / patient-message drafting.
BEDROCK_MODEL_ID=
# Standard AWS credential chain is used by boto3/langchain_aws.
AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Tracing (optional, LangSmith) ---
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=validor

# --- Contact form (site footer) ---
# Resend API key + destination address for the contact form.
RESEND_API_KEY=
CONTACT_EMAIL=
# Optional: override the From address (defaults to a resend.dev sandbox sender).
# CONTACT_FROM_EMAIL=Validor <onboarding@resend.dev>
